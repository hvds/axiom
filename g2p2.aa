*import int
*var A

#
# Phase 2: resolve \min(b+e,d+g) by splitting integrals until we can show
# either g <= b+e-d or g >= b+e-d; evaluate the resulting integrals over g.
#

# We need to split d into ranges d <= b, min_d <= b <= max_d, and d >= b.
# For that we first need c <= a+b-1, so we need to split b's range to
# separate cases a+b <= 1 and a+b >= 1.
  condstart Sb1a: (a >= 0) & (a <= 1)
    simplify: a <= 1
    multiply: -a >= -1
    add Sb1b: 1-a >= 0
    simplify(Sb1a): a >= 0
    multiply: -a <= 0
    add: 1-a <= 1
    conjoin(Sb1b): (1-a >= 0) & (1-a <= 1)
  condend: \Aa: ((a >= 0) & (a <= 1)) -> ((1-a >= 0) & (1-a <= 1))
theorem Sb1: \Aa: ((a >= 0) & (a <= 1)) -> ((1-a >= 0) & (1-a <= 1))

  condstart Sc1a: (b >= 0) & (b <= 1-a)
    simplify: b >= 0
    add Sc1b: a+b >= a
    simplify(Sc1a): b <= 1-a
    add: a+b <= 1
    conjoin(Sc1b): (a+b >= a) & (a+b <= 1)
  condend: \Aa: \Ab: ((b >= 0) & (b <= 1-a)) -> ((a+b >= a) & (a+b <= 1))
theorem Sc1: \Aa: \Ab: ((b >= 0) & (b <= 1-a)) -> ((a+b >= a) & (a+b <= 1))

  condstart Sc2a: (b >= 1-a) & (b <= 1)
    simplify: b >= 1-a
    add Sc2b: a+b-1 >= 0
    simplify(Sc2a): b <= 1
    add: a+b-1 <= a
    conjoin(Sc2b): (a+b-1 >= 0) & (a+b-1 <= a)
  condend: \Aa: \Ab: ((b >= 1-a) & (b <= 1)) -> ((a+b-1 >= 0) & (a+b-1 <= a))
theorem Sc2: \Aa: \Ab: ((b >= 1-a) & (b <= 1)) -> ((a+b-1 >= 0) & (a+b-1 <= a))

  condstart Sd1a: (b >= 0) & (b <= 1-a) & (c >= 0)
    simplify Sd1b: b >= 0
    simplify(Sd1a): c >= 0
    multiply Sd1c: -c <= 0
    simplify(Sd1a): b <= 1-a
    conjoin(Sd1c): (-c <= 0) & (b <= 1-a)
    ponens(int.Q8): b-c <= 1-a
    add: b <= 1-a+c
    conjoin(Sd1b): (b >= 0) & (b <= 1-a+c)
  condend: \Aa: \Ab: \Ac: ((b >= 0) & (b <= 1-a) & (c >= 0)) -> ((b >= 0) & (b <= 1-a+c))
theorem Sd1: \Aa: \Ab: \Ac: ((b >= 0) & (b <= 1-a) & (c >= 0)) -> ((b >= 0) & (b <= 1-a+c))

  condstart Sd2a: (b >= 0) & (c >= a+b)
    simplify Sd2b: b >= 0
    simplify(Sd2a): c >= a+b
    multiply: -c <= -a-b
    add: b <= c-a
    conjoin(Sd2b): (b >= 0) & (b <= c-a)
  condend: \Aa: \Ab: \Ac: ((b >= 0) & (c >= a+b)) -> ((b >= 0) & (b <= c-a))
theorem Sd2: \Aa: \Ab: \Ac: ((b >= 0) & (c >= a+b)) -> ((b >= 0) & (b <= c-a))

  condstart Sd3a: (a >= 0) & (b <= 1-a) & (c <= a+b)
    simplify: c <= a+b
    multiply: -c >= -a-b
    add Sd3b: b >= c-a
    simplify(Sd3a): a >= 0
    multiply Sd3c: -a <= 0
    simplify(Sd3a): b <= 1-a
    conjoin(Sd3c): (-a <= 0) & (b <= 1-a)
    ponens(int.Q8): b-a <= 1-a
    add: b <= 1
    conjoin(Sd3b): (b >= c-a) & (b <= 1)
  condend: \Aa: \Ab: \Ac: ((a >= 0) & (b <= 1-a) & (c <= a+b)) -> ((b >= c-a) & (b <= 1))
theorem Sd3: \Aa: \Ab: \Ac: ((a >= 0) & (b <= 1-a) & (c <= a+b)) -> ((b >= c-a) & (b <= 1))

  condstart Sd4a: (a <= 1) & (b >= 1-a) & (c >= a+b-1)
    simplify: a <= 1
    multiply Sd4b: -a >= -1
    simplify(Sd4a): b >= 1-a
    conjoin(Sd4b): (-a >= -1) & (b >= 1-a)
    ponens(int.Q7): b-a >= -a
    add Sd4c: b >= 0
    simplify(Sd4a): c >= a+b-1
    multiply: -c <= 1-a-b
    add: b <= 1-a+c
    conjoin(Sd4c): (b >= 0) & (b <= 1-a+c)
  condend: \Aa: \Ab: \Ac: ((a <= 1) & (b >= 1-a) & (c >= -1+a+b)) -> ((b >= 0) & (b <= 1-a+c))
theorem Sd4: \Aa: \Ab: \Ac: ((a <= 1) & (b >= 1-a) & (c >= -1+a+b)) -> ((b >= 0) & (b <= 1-a+c))

  condstart Sd5a: (b >= 1-a) & (b <= 1) & (c <= 1)
    simplify Sd5b: b >= 1-a
    simplify(Sd5a): c <= 1
    multiply: -c >= -1
    conjoin(Sd5b): (b >= 1-a) & (-c >= -1)
    ponens(int.Q7): b-c >= -a
    add Sd5c: b >= c-a
    simplify(Sd5a): b <= 1
    conjoin(Sd5c): (b >= c-a) & (b <= 1)
  condend: \Aa: \Ab: \Ac: ((b >= 1-a) & (b <= 1) & (c <= 1)) -> ((b >= c-a) & (b <= 1))
theorem Sd5: \Aa: \Ab: \Ac: ((b >= 1-a) & (b <= 1) & (c <= 1)) -> ((b >= c-a) & (b <= 1))

  condstart H1a: (a >= 0) & (b <= 1-a)
    simplify: a >= 0
    multiply H1b: -a <= 0
    simplify(H1a): b <= 1-a
    conjoin(H1b): (-a <= 0) & (b <= 1-a)
    ponens(int.Q8): -a+b <= 1-a
    add H1c: b <= 1
  condend: \Aa: \Ab: ((a >= 0) & (b <= 1-a)) -> (b <= 1)
theorem H1: \Aa: \Ab: ((a >= 0) & (b <= 1-a)) -> (b <= 1)

  condstart H2a: (a >= 0) & (c <= 1) & (d <= c-a)
    simplify: a >= 0
    multiply H2b: -a <= 0
    simplify(H2a): (c <= 1) & (d <= c-a)
    ponens(int.Q8): c+d <= 1+c-a
    conjoin(H2b): (-a <= 0) & (c+d <= 1+c-a)
    ponens(int.Q8): c+d-a <= 1+c-a
    add: d <= 1
  condend: \Aa: \Ac: \Ad: ((a >= 0) & (c <= 1) & (d <= c-a)) -> (d <= 1)
theorem H2: \Aa: \Ac: \Ad: ((a >= 0) & (c <= 1) & (d <= c-a)) -> (d <= 1)

  condstart H3a: (a <= 1) & (b >= 1-a)
    simplify: a <= 1
    multiply H3b: -a >= -1
    simplify(H3a): b >= 1-a
    conjoin(H3b): (-a >= -1) & (b >= 1-a)
    ponens(int.Q7): b-a >= -a
    add: b >= 0
  condend: \Aa: \Ab: ((a <= 1) & (b >= 1-a)) -> (b >= 0)
theorem H3: \Aa: \Ab: ((a <= 1) & (b >= 1-a)) -> (b >= 0)

  condstart H4a: (b >= 1-a) & (c <= 1) & (d <= c-a)
    simplify: b >= 1-a
    multiply H4b: -b <= -1+a
    simplify(H4a): (c <= 1) & (d <= c-a)
    ponens(int.Q8): c+d <= 1+c-a
    conjoin(H4b): (-b <= -1+a) & (c+d <= 1+c-a)
    ponens(int.Q8): -b+c+d <= c
    add: d <= b
  condend: \Aa: \Ab: \Ac: \Ad: ((b >= 1-a) & (c <= 1) & (d <= c-a)) -> (d <= b)
theorem H4: \Aa: \Ab: \Ac: \Ad: ((b >= 1-a) & (c <= 1) & (d <= c-a)) -> (d <= b)

  condstart Se1a: (b <= 1) & (d >= 0) & (d <= b)
    simplify: b <= 1
    multiply Se1b: -b >= -1
    simplify(Se1a): d >= 0
    conjoin(Se1b): (-b >= -1) & (d >= 0)
    ponens(int.Q7): -b+d >= -1
    add Se1c: 1-b+d >= 0
    simplify(Se1a): d <= b
    add: 1-b+d <= 1
    conjoin(Se1c): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Ab: \Ad: ((b <= 1) & (d >= 0) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se1: \Ab: \Ad: ((b <= 1) & (d >= 0) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se2a: (b >= 0) & (d >= b) & (d <= 1)
    simplify: d >= b
    add Se2b: d-b >= 0
    simplify(Se2a): b >= 0
    multiply Se2c: -b <= 0
    simplify(Se2a): d <= 1
    conjoin(Se2c): (-b <= 0) & (d <= 1)
    ponens(int.Q8): d-b <= 1
    conjoin(Se2b): (d-b >= 0) & (d-b <= 1)
  condend: \Ab: \Ad: ((b >= 0) & (d >= b) & (d <= 1)) -> ((d-b >= 0) & (d-b <= 1))
theorem Se2: \Ab: \Ad: ((b >= 0) & (d >= b) & (d <= 1)) -> ((d-b >= 0) & (d-b <= 1))

  condstart Se3a: (a >= 0) & (b <= 1-a) & (d >= 0) & (d <= b)
    simplify: (a >= 0) & (b <= 1-a)
    ponens(H1) Se3b: b <= 1
    simplify(Se3a): (d >= 0) & (d <= b)
    conjoin(Se3b): (b <= 1) & (d >= 0) & (d <= b)
    ponens(Se1): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Aa: \Ab: \Ad: ((a >= 0) & (b <= 1-a) & (d >= 0) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se3: \Aa: \Ab: \Ad: ((a >= 0) & (b <= 1-a) & (d >= 0) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se4a: (c <= a) & (b >= 0) & (d >= b) & (d <= 1-a+c)
    simplify: (c <= a) & (d <= 1-a+c)
    ponens(int.Q8): c+d <= 1+c
    add Se4b: d <= 1
    simplify(Se4a): (b >= 0) & (d >= b)
    conjoin(Se4b): (b >= 0) & (d >= b) & (d <= 1)
    ponens(Se2): (d-b >= 0) & (d-b <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((c <= a) & (b >= 0) & (d >= b) & (d <= 1-a+c)) -> ((d-b >= 0) & (d-b <= 1))
theorem Se4: \Aa: \Ab: \Ac: \Ad: ((c <= a) & (b >= 0) & (d >= b) & (d <= 1-a+c)) -> ((d-b >= 0) & (d-b <= 1))

  condstart Se5a: (a >= 0) & (b <= 1-a) & (c <= a+b) & (d >= 0) & (d <= c-a)
    simplify: (a >= 0) & (b <= 1-a)
    ponens(H1) Se5b: b <= 1
    simplify(Se5a): (c <= a+b) & (d <= c-a)
    ponens(int.Q8): c+d <= b+c
    add Se5c: d <= b
    simplify(Se5a): d >= 0
    conjoin(Se5b): (b <= 1) & (d >= 0)
    conjoin(Se5c): (b <= 1) & (d >= 0) & (d <= b)
    ponens(Se1): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((a >= 0) & (b <= 1-a) & (c <= a+b) & (d >= 0) & (d <= c-a)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se5: \Aa: \Ab: \Ac: \Ad: ((a >= 0) & (b <= 1-a) & (c <= a+b) & (d >= 0) & (d <= c-a)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se6a: (a >= 0) & (b <= 1-a) & (d >= 0) & (d <= b)
    simplify: (a >= 0) & (b <= 1-a)
    ponens(H1) Se6b: b <= 1
    simplify(Se6a): (d >= 0) & (d <= b)
    conjoin(Se6b): (b <= 1) & (d >= 0) & (d <= b)
    ponens(Se1): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Aa: \Ab: \Ad: ((a >= 0) & (b <= 1-a) & (d >= 0) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se6: \Aa: \Ab: \Ad: ((a >= 0) & (b <= 1-a) & (d >= 0) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se7a: (a >= 0) & (b >= 0) & (c <= 1) & (d >= b) & (d <= c-a)
    simplify: (a >= 0) & (c <= 1) & (d <= c-a)
    ponens(H2) Se7b: d <= 1
    simplify(Se7a): (b >= 0) & (d >= b)
    conjoin(Se7b): (b >= 0) & (d >= b) & (d <= 1)
    ponens(Se2): (d-b >= 0) & (d-b <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((a >= 0) & (b >= 0) & (c <= 1) & (d >= b) & (d <= c-a)) -> ((d-b >= 0) & (d-b <= 1))
theorem Se7: \Aa: \Ab: \Ac: \Ad: ((a >= 0) & (b >= 0) & (c <= 1) & (d >= b) & (d <= c-a)) -> ((d-b >= 0) & (d-b <= 1))

  condstart Se8a: (a >= 0) & (b <= 1-a) & (c >= a) & (d >= c-a) & (d <= b)
    simplify: (a >= 0) & (b <= 1-a)
    ponens(H1) Se8b: b <= 1
    simplify(Se8a): (c >= a) & (d >= c-a)
    ponens(int.Q7): c+d >= c
    add Se8c: d >= 0
    simplify(Se8a): d <= b
    conjoin(Se8c): (d >= 0) & (d <= b)
    conjoin(Se8b): (b <= 1) & (d >= 0) & (d <= b)
    ponens(Se1): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((a >= 0) & (b <= 1-a) & (c >= a) & (d >= c-a) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se8: \Aa: \Ab: \Ac: \Ad: ((a >= 0) & (b <= 1-a) & (c >= a) & (d >= c-a) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se9a: (b >= 0) & (c >= a+b) & (d >= c-a) & (d <= 1)
    simplify: (c >= a+b) & (d >= c-a)
    ponens(int.Q7): c+d >= b+c
    add Se9b: d >= b
    simplify(Se9a): (b >= 0) & (d <= 1)
    conjoin(Se9b): (b >= 0) & (d >= b) & (d <= 1)
    ponens(Se2): (d-b >= 0) & (d-b <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((b >= 0) & (c >= a+b) & (d >= c-a) & (d <= 1)) -> ((d-b >= 0) & (d-b <= 1))
theorem Se9: \Aa: \Ab: \Ac: \Ad: ((b >= 0) & (c >= a+b) & (d >= c-a) & (d <= 1)) -> ((d-b >= 0) & (d-b <= 1))

  condstart Se10a: (b <= 1) & (c <= a+b-1) & (d >= 0) & (d <= 1-a+c)
    simplify: (c <= a+b-1) & (d <= 1-a+c)
    ponens(int.Q8): c+d <= b+c
    add Se10b: d <= b
    simplify(Se10a): (b <= 1) & (d >= 0)
    conjoin(Se10b): (b <= 1) & (d >= 0) & (d <= b)
    ponens(Se1): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((b <= 1) & (c <= a+b-1) & (d >= 0) & (d <= 1-a+c)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se10: \Aa: \Ab: \Ac: \Ad: ((b <= 1) & (c <= a+b-1) & (d >= 0) & (d <= 1-a+c)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se11a: (a <= 1) & (b >= 1-a) & (c <= a) & (d >= b) & (d <= 1-a+c)
    simplify: (a <= 1) & (b >= 1-a)
    ponens(H3) Se11b: b >= 0
    simplify(Se11a): (c <= a) & (d <= 1-a+c)
    ponens(int.Q8): c+d <= 1+c
    add Se11c: d <= 1
    simplify(Se11a): d >= b
    conjoin(Se11c): (d >= b) & (d <= 1)
    conjoin(Se11b): (b >= 0) & (d >= b) & (d <= 1)
    ponens(Se2): (d-b >= 0) & (d-b <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((a <= 1) & (b >= 1-a) & (c <= a) & (d >= b) & (d <= 1-a+c)) -> ((d-b >= 0) & (d-b <= 1))
theorem Se11: \Aa: \Ab: \Ac: \Ad: ((a <= 1) & (b >= 1-a) & (c <= a) & (d >= b) & (d <= 1-a+c)) -> ((d-b >= 0) & (d-b <= 1))

  condstart Se12a: (b >= 1-a) & (b <= 1) & (c <= 1) & (d >= 0) & (d <= c-a)
    simplify: (b >= 1-a) & (c <= 1) & (d <= c-a)
    ponens(H4) Se12b: d <= b
    simplify(Se12a): (b <= 1) & (d >= 0)
    conjoin(Se12b): (b <= 1) & (d >= 0) & (d <= b)
    ponens(Se1): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((b >= 1-a) & (b <= 1) & (c <= 1) & (d >= 0) & (d <= c-a)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se12: \Aa: \Ab: \Ac: \Ad: ((b >= 1-a) & (b <= 1) & (c <= 1) & (d >= 0) & (d <= c-a)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se13a: (b <= 1) & (c >= a) & (d >= c-a) & (d <= b)
    simplify: (c >= a) & (d >= c-a)
    ponens(int.Q7): c+d >= c
    add Se13b: d >= 0
    simplify(Se13a): (b <= 1) & (d <= b)
    conjoin(Se13b): (b <= 1) & (d >= 0) & (d <= b)
    ponens(Se1): (1-b+d >= 0) & (1-b+d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: ((b <= 1) & (c >= a) & (d >= c-a) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))
theorem Se13: \Aa: \Ab: \Ac: \Ad: ((b <= 1) & (c >= a) & (d >= c-a) & (d <= b)) -> ((1-b+d >= 0) & (1-b+d <= 1))

  condstart Se14a: (a <= 1) & (b >= 1-a) & (d >= b) & (d <= 1)
    simplify: (a <= 1) & (b >= 1-a)
    ponens(H3) Se14b: b >= 0
    simplify(Se14a): (d >= b) & (d <= 1)
    conjoin(Se14b): (b >= 0) & (d >= b) & (d <= 1)
    ponens(Se2): (d-b >= 0) & (d-b <= 1)
  condend: \Aa: \Ab: \Ad: ((a <= 1) & (b >= 1-a) & (d >= b) & (d <= 1)) -> ((d-b >= 0) & (d-b <= 1))
theorem Se14: \Aa: \Ab: \Ad: ((a <= 1) & (b >= 1-a) & (d >= b) & (d <= 1)) -> ((d-b >= 0) & (d-b <= 1))

  condstart Si1a: (d <= b) & (e >= 0) & (e <= 1-b+d)
    simplify: d <= b
    multiply Si1b: -d >= -b
    simplify(Si1a): e >= 0
    conjoin(Si1b): (-d >= -b) & (e >= 0)
    ponens(int.Q7): e-d >= -b
    add Si1c: b+e-d >= 0
    simplify(Si1a): e <= 1-b+d
    add: b+e-d <= 1
    conjoin(Si1c): (b+e-d >= 0) & (b+e-d <= 1)
  condend: \Ab: \Ad: \Ae: ((d <= b) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))
theorem Si1: \Ab: \Ad: \Ae: ((d <= b) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))

  condstart Si2a: (d >= b) & (e >= d-b) & (e <= 1)
    simplify: e >= d-b
    add Si2b: b+e-d >= 0
    simplify(Si2a) Si2c: e <= 1
    simplify(Si2a): d >= b
    multiply: -d <= -b
    conjoin(Si2c): (e <= 1) & (-d <= -b)
    ponens(int.Q8): e-d <= 1-b
    add: b+e-d <= 1
    conjoin(Si2b): (b+e-d >= 0) & (b+e-d <= 1)
  condend: \Ab: \Ad: \Ae: ((d >= b) & (e >= d-b) & (e <= 1)) -> ((b+e-d >= 0) & (b+e-d <= 1))
theorem Si2: \Ab: \Ad: \Ae: ((d >= b) & (e >= d-b) & (e <= 1)) -> ((b+e-d >= 0) & (b+e-d <= 1))

  condstart Si3a: (c <= a+b) & (d <= c-a) & (e >= 0) & (e <= 1-b+d)
    simplify: (c <= a+b) & (d <= c-a)
    ponens(int.Q8): c+d <= b+c
    add Si3b: d <= b
    simplify(Si3a): (e >= 0) & (e <= 1-b+d)
    conjoin(Si3b): (d <= b) & (e >= 0) & (e <= 1-b+d)
    ponens(Si1): (b+e-d >= 0) & (b+e-d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: \Ae: ((c <= a+b) & (d <= c-a) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))
theorem Si3: \Aa: \Ab: \Ac: \Ad: \Ae: ((c <= a+b) & (d <= c-a) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))

  condstart Si4a: (c >= a+b) & (d >= c-a) & (e >= d-b) & (e <= 1)
    simplify: (c >= a+b) & (d >= c-a)
    ponens(int.Q7): c+d >= b+c
    add Si4b: d >= b
    simplify(Si4a): (e >= d-b) & (e <= 1)
    conjoin(Si4b): (d >= b) & (e >= d-b) & (e <= 1)
    ponens(Si2): (b+e-d >= 0) & (b+e-d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: \Ae: ((c >= a+b) & (d >= c-a) & (e >= d-b) & (e <= 1)) -> ((b+e-d >= 0) & (b+e-d <= 1))
theorem Si4: \Aa: \Ab: \Ac: \Ad: \Ae: ((c >= a+b) & (d >= c-a) & (e >= d-b) & (e <= 1)) -> ((b+e-d >= 0) & (b+e-d <= 1))

  condstart Si5a: (c <= a+b-1) & (d <= 1-a+c) & (e >= 0) & (e <= 1-b+d)
    simplify: (c <= a+b-1) & (d <= 1-a+c)
    ponens(int.Q8): c+d <= b+c
    add Si5b: d <= b
    simplify(Si5a): (e >= 0) & (e <= 1-b+d)
    conjoin(Si5b): (d <= b) & (e >= 0) & (e <= 1-b+d)
    ponens(Si1): (b+e-d >= 0) & (b+e-d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: \Ae: ((c <= a+b-1) & (d <= 1-a+c) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))
theorem Si5: \Aa: \Ab: \Ac: \Ad: \Ae: ((c <= a+b-1) & (d <= 1-a+c) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))

  condstart Si6a: (b >= 1-a) & (c <= 1) & (d <= c-a) & (e >= 0) & (e <= 1-b+d)
    simplify: b >= 1-a
    multiply Si6b: -b <= -1+a
    simplify(Si6a): (c <= 1) & (d <= c-a)
    ponens(int.Q8): c+d <= 1+c-a
    conjoin(Si6b): (-b <= -1+a) & (c+d <= 1+c-a)
    ponens(int.Q8): -b+c+d <= c
    add Si6c: d <= b
    simplify(Si6a): (e >= 0) & (e <= 1-b+d)
    conjoin(Si6c): (d <= b) & (e >= 0) & (e <= 1-b+d)
    ponens(Si1): (b+e-d >= 0) & (b+e-d <= 1)
  condend: \Aa: \Ab: \Ac: \Ad: \Ae: ((b >= 1-a) & (c <= 1) & (d <= c-a) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))
theorem Si6: \Aa: \Ab: \Ac: \Ad: \Ae: ((b >= 1-a) & (c <= 1) & (d <= c-a) & (e >= 0) & (e <= 1-b+d)) -> ((b+e-d >= 0) & (b+e-d <= 1))

  condstart: g <= b+e-d
    multiply: -g >= -b-e+d
    add: b+e >= d+g
    ponens(int.M2): \min(b+e,d+g) = d+g
  condend: \Ab: \Ad: \Ae: \Ag: (g <= b+e-d) -> (\min(b+e,d+g) = d+g)
  given: \Ab: \Ad: \Ae: \Ag: \given_{g <= b+e-d}{\min(b+e,d+g)} = d+g
theorem Min1: \Ab: \Ad: \Ae: \Ag: \given_{g <= b+e-d}{\min(b+e,d+g)} = d+g

  condstart Min2a: (e >= 1-b+d) & (g <= 1)
    simplify: g <= 1
    multiply Min2b: -g >= -1
    simplify(Min2a): e >= 1-b+d
    conjoin(Min2b): (e >= 1-b+d) & (-g >= -1)
    ponens(int.Q7): e-g >= -b+d
    add: b+e >= d+g
    ponens(int.M2): \min(b+e,d+g) = d+g
  condend: \Ab: \Ad: \Ae: \Ag: ((e >= 1-b+d) & (g <= 1)) -> (\min(b+e,d+g) = d+g)
  given: \Ab: \Ad: \Ae: \Ag: \given_{(e >= 1-b+d) & (g <= 1)}{\min(b+e,d+g)} = d+g
theorem Min2: \Ab: \Ad: \Ae: \Ag: \given_{(e >= 1-b+d) & (g <= 1)}{\min(b+e,d+g)} = d+g

  condstart: g >= b+e-d
    multiply: -g <= -b-e+d
    add: b+e <= d+g
    ponens(int.M1): \min(b+e,d+g) = b+e
  condend: \Ab: \Ad: \Ae: \Ag: (g >= b+e-d) -> (\min(b+e,d+g) = b+e)
  given: \Ab: \Ad: \Ae: \Ag: \given_{g >= b+e-d}{\min(b+e,d+g)} = b+e
theorem Min3: \Ab: \Ad: \Ae: \Ag: \given_{g >= b+e-d}{\min(b+e,d+g)} = b+e

  condstart Min4a: (e <= d-b) & (g >= 0)
    simplify: g >= 0
    multiply Min4b: -g <= 0
    simplify(Min4a): e <= d-b
    conjoin(Min4b): (-g <= 0) & (e <= d-b)
    ponens(int.Q8): e-g <= d-b
    add: b+e <= d+g
    ponens(int.M1): \min(b+e,d+g) = b+e
  condend: \Ab: \Ad: \Ae: \Ag: ((e <= d-b) & (g >= 0)) -> (\min(b+e,d+g) = b+e)
  given: \Ab: \Ad: \Ae: \Ag: \given_{(e <= d-b) & (g >= 0)}{\min(b+e,d+g)} = b+e
theorem Min4: \Ab: \Ad: \Ae: \Ag: \given_{(e <= d-b) & (g >= 0)}{\min(b+e,d+g)} = b+e

  condstart LI1a: (b+e-d >= 0) & (b+e-d <= 1)
    identity: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^1{ a+\min(b+e,d+g) }
    itersplit(*with LI1a): \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^{b+e-d}{ a+\min(b+e,d+g) } + \int_{g=b+e-d}^1{ a+\min(b+e,d+g) }
    give: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^{b+e-d}{ a+\given_{g <= b+e-d }{\min(b+e,d+g)} } + \int_{g=b+e-d}^1{ a+\min(b+e,d+g) }
    equate(Min1): \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^{b+e-d}{ a+d+g } + \int_{g=b+e-d}^1{ a+\min(b+e,d+g) }
    give: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^{b+e-d}{ a+d+g } + \int_{g=b+e-d}^1{ a+\given_{g >= b+e-d }{\min(b+e,d+g)} }
    equate(Min3): \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^{b+e-d}{ a+d+g } + \int_{g=b+e-d}^1{ a+b+e }
    integrate: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \inteval_{g=0}^{b+e-d}{ (a+d)g+g^2/2 } + \int_{g=b+e-d}^1{ a+b+e }
    integrate: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \inteval_{g=0}^{b+e-d}{ (a+d)g+g^2/2 } + \inteval_{g=b+e-d}^1{ (a+b+e)g }
    inteval: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (a+d)(b+e-d)+(b+e-d)^2/2 + \inteval_{g=b+e-d}^1{ (a+b+e)g }
    inteval: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (a+d)(b+e-d)+(b+e-d)^2/2 + (a+b+e) - (a+b+e)(b+e-d)
    factor: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (2(a+d)(b+e-d)+(b+e-d)^2 + 2(a+b+e) - 2(a+b+e)(b+e-d))/2
    factor: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (2(a+b+e) + (b+e-d)(b+e-d+2(a+d)-2(a+b+e)))/2
    distrib: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (2(a+b+e) + (b+e-d)(2a+b+d+e-2(a+b+e)))/2
    distrib: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (2(a+b+e) + (b+e-d)(-b+d-e))/2
    factor: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (2(a+b+e) - (b+e-d)(b+e-d))/2
    factor: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (2(a+b+e) - (b+e-d)^2)/2
  condend: \Aa: \Ab: \Ad: \Ae: ((b+e-d >= 0) & (b+e-d <= 1)) -> (\int_{g=0}^1{ a+\min(b+e,d+g) } = (2(a+b+e) - (b+e-d)^2)/2)
  given: \Aa: \Ab: \Ad: \Ae: \given_{(b+e-d >= 0) & (b+e-d <= 1)}{\int_{g=0}^1{ a+\min(b+e,d+g) }} = (2(a+b+e) - (b+e-d)^2)/2
theorem Int1: \Aa: \Ab: \Ad: \Ae: \given_{(b+e-d >= 0) & (b+e-d <= 1)}{\int_{g=0}^1{ a+\min(b+e,d+g) }} = (2(a+b+e) - (b+e-d)^2)/2

  condstart LI2a: e >= 1-b+d
    identity: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^1{ a+\min(b+e,d+g) }
    give(*with LI2a): \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^1{ a+\given_{(e >= 1-b+d) & (g <= 1)}{\min(b+e,d+g)} }
    equate(Min2): \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^1{ a+d+g }
    integrate:  \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \inteval_{g=0}^1{ (a+d)g+g^2/2 }
    inteval: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = a+d+1/2
    factor: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = (2a+2d+1)/2
  condend: \Aa: \Ab: \Ad: \Ae: (e >= 1-b+d) -> (\int_{g=0}^1{ a+\min(b+e,d+g) } = (2a+2d+1)/2)
  given: \Aa: \Ab: \Ad: \Ae: \given_{e >= 1-b+d}{\int_{g=0}^1{ a+\min(b+e,d+g) }} = (2a+2d+1)/2
theorem Int2: \Aa: \Ab: \Ad: \Ae: \given_{e >= 1-b+d}{\int_{g=0}^1{ a+\min(b+e,d+g) }} = (2a+2d+1)/2

  condstart LI3a: e <= d-b
    identity: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^1{ a+\min(b+e,d+g) }
    give(*with LI3a): \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^1{ a+\given_{(e <= d-b) & (g >= 0)}{\min(b+e,d+g)} }
    equate(Min4): \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \int_{g=0}^1{ a+b+e }
    integrate: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = \inteval_{g=0}^1{ (a+b+e)g }
    inteval: \Aa: \int_{g=0}^1{ a+\min(b+e,d+g) } = a+b+e
  condend: \Aa: \Ab: \Ad: \Ae: (e <= d-b) -> (\int_{g=0}^1{ a+\min(b+e,d+g) } = a+b+e)
  given: \Aa: \Ab: \Ad: \Ae: \given_{e <= d-b}{\int_{g=0}^1{ a+\min(b+e,d+g) }} = a+b+e
theorem Int3: \Aa: \Ab: \Ad: \Ae: \given_{e <= d-b}{\int_{g=0}^1{ a+\min(b+e,d+g) }} = a+b+e

#
# Carry forward from the endpoint of part 1.
#
condstart: A = \int_{a=0}^1{ \int_{b=0}^1{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^1{ \int_{d=0}^{c-a}{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } } } }
  #
  # We want to split each d-range so that either d <= b or d >= b. For some
  # cases that means we must first split the c- or b-ranges.
  #
  itersplit(*with Sb1): A = \int_{a=0}^1{ \int_{b=0}^{1-a}{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^1{ \int_{d=0}^{c-a}{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } } } + \int_{b=1-a}^1{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^1{ \int_{d=0}^{c-a}{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } } } }
  unarydistrib: A = \int_{a=0}^1{ \int_{b=0}^{1-a}{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^1{ \int_{d=0}^{c-a}{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } } + \int_{c=a}^1{ \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } } } + \int_{b=1-a}^1{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^1{ \int_{d=0}^{c-a}{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } } } }
