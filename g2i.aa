  ponens(C5c): \Aa: \Ab: \Ac: \Ad: \Ae: \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) }
