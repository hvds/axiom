*import int

specify(int.M5): \Ax: \min(1, x) <= 1
theorem Ma1: \Ax: \min(1, x) <= 1

specify(int.M7): \Ax: \max(0, x) >= 0
theorem Ma2: \Ax: \max(0, x) >= 0

specify(Ma2) Ma3a: \Ax: \max(0, \min(1, x)) >= 0
specify(Ma1) Ma3b: \Ax: \min(1, \max(0, x)) <= 1
specify(int.M9) Ma3c: (0 <= 1) -> (\Ac: \max(0,\min(1,c)) = \min(1,\max(0,c)))
ponens(int.Q9a: Ma3c) Ma3d: \Ac: \max(0,\min(1,c)) = \min(1,\max(0,c))
equate(Ma3b: Ma3d): \Ax: \max(0,\min(1,x)) <= 1
conjoin(Ma3a): \Ax: (\max(0, \min(1, x)) >= 0) & (\max(0,\min(1, x)) <= 1)
theorem Ma3: \Ax: (\max(0, \min(1, x)) >= 0) & (\max(0, \min(1, x)) <= 1)

specify(Ma3): \Aa: \Ab: \Ac: \Ad: \Ae: \Af: (\max(0,\min(1,a+b+e-\min(a+d,c+f))) >= 0) & (\max(0,\min(1,a+b+e-\min(a+d,c+f))) <= 1)
theorem C1: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: (\max(0,\min(1,a+b+e-\min(a+d,c+f))) >= 0) & (\max(0,\min(1,a+b+e-\min(a+d,c+f))) <= 1)

rename(int.I3): \Ac: \Ad: \int_{g=0}^{\max(0,\min(1,c-d))}{ \min(c,d+g) } = \int_{g=0}^{\max(0,\min(1,c-d))}{ d+g }
specify: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+b+e,\min(a+d,c+f)+g) } = \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+d,c+f)+g }
theorem C2: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+b+e,\min(a+d,c+f)+g) } = \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+d,c+f)+g }

rename(int.I4): \Ac: \Ad: \int_{g=\max(0,\min(1,c-d))}^{1}{ \min(c,d+g) } = \int_{g=\max(0,\min(1,c-d))}^{1}{ c }
specify: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: \int_{g=\max(0,\min(1,a+b+e-\min(a+d,c+f)))}^{1}{ \min(a+b+e,\min(a+d,c+f)+g) } = \int_{g=\max(0,\min(1,a+b+e-\min(a+d,c+f)))}^{1}{ a+b+e }
theorem C3: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: \int_{g=\max(0,\min(1,a+b+e-\min(a+d,c+f)))}^1{ \min(a+b+e,\min(a+d,c+f)+g) } = \int_{g=\max(0,\min(1,a+b+e-\min(a+d,c+f)))}^1{a+b+e}

specify(Ma3): \Aa: \Ab: \Ac: \Ad: \Ae: (\max(0,\min(1,\min(a+d-c,a+b+e-c))) >= 0) & (\max(0,\min(1,\min(a+d-c,a+b+e-c))) <= 1)
theorem C4: \Aa: \Ab: \Ac: \Ad: \Ae: (\max(0,\min(1,\min(a+d-c,a+b+e-c))) >= 0) & (\max(0,\min(1,\min(a+d-c,a+b+e-c))) <= 1)

  condstart COND51a: \min(a+d-c,a+b+e-c) <= 0
    specify(int.Q10) COND51b: ((\min(a+d-c,a+b+e-c) <= 0) & (0 <= 1)) -> (\min(a+d-c,a+b+e-c) <= 1)
    specify(int.M2) COND51c: (1 >= \min(a+d-c,a+b+e-c)) -> (\min(1, \min(a+d-c,a+b+e-c)) = \min(a+d-c,a+b+e-c))
    specify(int.M4) COND51d: (0 >= \min(a+d-c,a+b+e-c)) -> (\max(0, \min(a+d-c,a+b+e-c)) = 0)

    conjoin(COND51a: int.Q9a): (\min(a+d-c,a+b+e-c) <= 0) & (0 <= 1)
    ponens(COND51b): \min(a+d-c,a+b+e-c) <= 1
    add: -1 <= -\min(a+d-c,a+b+e-c)
    multiply: 1 >= \min(a+d-c,a+b+e-c)
    ponens(COND51c) COND51e: \min(1, \min(a+d-c,a+b+e-c)) = \min(a+d-c,a+b+e-c)

    add(COND51a): 0 <= -\min(a+d-c,a+b+e-c)
    multiply(*value -1): 0 >= \min(a+d-c,a+b+e-c)
    ponens(COND51d): \max(0, \min(a+d-c,a+b+e-c)) = 0
    equate(COND51e) COND51f: \max(0, \min(1, \min(a+d-c,a+b+e-c))) = 0

    rename(int.I1) COND51g: \Aa: \Ab: \int_{f=a}^{a}{b} = 0
    specify COND51h: \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = 0
    specify(COND51g) COND51i: \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) } = 0

    identity: \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) }
    equate(COND51f): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) }
    equate(COND51h): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = 0
    equate(COND51i): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) }
    equate(COND51f): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) }
  condend C5a: \Aa: \Ab: \Ac: \Ad: \Ae: (\min(a+d-c,a+b+e-c) <= 0) -> (\int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) })

  condstart COND52a: \min(a+d-c,a+b+e-c) >= 0
    specify(int.M10) COND52b: ((1 >= 0) & (\min(a+d-c,a+b+e-c) >= 0)) -> (\min(1, \min(a+d-c,a+b+e-c)) >= 0)
    specify(int.M3) COND52c: (0 <= \min(1, \min(a+d-c,a+b+e-c))) -> (\max(0, \min(1, \min(a+d-c,a+b+e-c))) = \min(1, \min(a+d-c,a+b+e-c)))

    add(int.Q9a): -1 <= 0
    multiply: 1 >= 0
    conjoin(COND52a): (1 >= 0) & (\min(a+d-c,a+b+e-c) >= 0)
    ponens(COND52b): \min(1, \min(a+d-c,a+b+e-c)) >= 0
    add: 0 >= -\min(1, \min(a+d-c,a+b+e-c))
    multiply: 0 <= \min(1, \min(a+d-c,a+b+e-c))
    ponens(COND52c) COND52d: \max(0, \min(1, \min(a+d-c,a+b+e-c))) = \min(1, \min(a+d-c,a+b+e-c))

    condstart COND521a: f <= \min(1, \min(a+d-c,a+b+e-c))
      condstart COND522a: f <= \min(a+d-c,a+b+e-c)
        specify(int.Q10) COND522b: ((f <= \min(a+d-c,a+b+e-c)) & (\min(a+d-c,a+b+e-c) <= a+d-c)) -> (f <= a+d-c)
        specify(int.M2) COND522d: (a+d >= c+f) -> (\min(a+d, c+f) = c+f)
        specify(int.M5): \min(a+d-c, a+b+e-c) <= a+d-c
        conjoin(COND522a): (f <= \min(a+d-c,a+b+e-c)) & (\min(a+d-c, a+b+e-c) <= a+d-c)
        ponens(COND522b): f <= a+d-c
        add: -a-d <= -c-f
        multiply(*value -1): a+d >= c+f
      condend COND521b: (f <= \min(a+d-c,a+b+e-c)) -> (a+d >= c+f)

      specify(int.M6) COND521c: \min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c)
      specify(int.Q10) COND521d: (((f <= \min(1, \min(a+d-c,a+b+e-c))) & (\min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c))) -> (f <= \min(a+d-c,a+b+e-c)))

      conjoin(COND521a: COND521c): (f <= \min(1, \min(a+d-c,a+b+e-c))) & (\min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c))
      ponens(COND521d): f <= \min(a+d-c,a+b+e-c)
      ponens(COND521b): a+d >= c+f
    condend: \Af: (f <= \min(1, \min(a+d-c,a+b+e-c))) -> (a+d >= c+f)
    equate(COND52d) COND52e: \Af: (f <= \max(0, \min(1, \min(a+d-c,a+b+e-c)))) -> (a+d >= c+f)

    identity: \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) }
    minmax(*with COND52e): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-(c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) }
    minmax(*with COND52e): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-(c+f)))^2/2 + (c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) }
    minmax(*with COND52e): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-(c+f)))^2/2 + (c+f)\max(0,\min(1,a+b+e-(c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) }
    minmax(*with COND52e): \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-(c+f)))^2/2 + (c+f)\max(0,\min(1,a+b+e-(c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-(c+f))) }
    unarydistrib: \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-c-f))^2/2 + (c+f)\max(0,\min(1,a+b+e-(c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-(c+f))) }
