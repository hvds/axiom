    rename(int.Q10): \Ax: \Ay: \Az: ((x <= y) & (y <= z)) -> (x <= z)
    specify: \Ay: \Az: ((\min(a+d-c,a+b+e-c) <= y) & (y <= z)) -> (\min(a+d-c,a+b+e-c) <= z)
    specify: \Az: ((\min(a+d-c,a+b+e-c) <= 0) & (0 <= z)) -> (\min(a+d-c,a+b+e-c) <= z)
    specify: ((\min(a+d-c,a+b+e-c) <= 0) & (0 <= 1)) -> (\min(a+d-c,a+b+e-c) <= 1)
    theorem COND51b: ((\min(a+d-c,a+b+e-c) <= 0) & (0 <= 1)) -> (\min(a+d-c,a+b+e-c) <= 1)

    rename(int.M2): \Ax: \Ay: (x >= y) -> (\min(x, y) = y)
    specify: \Ay: (1 >= y) -> (\min(1, y) = y)
    specify: (1 >= \min(a+d-c,a+b+e-c)) -> (\min(1, \min(a+d-c,a+b+e-c)) = \min(a+d-c,a+b+e-c))
    theorem COND51c: (1 >= \min(a+d-c,a+b+e-c)) -> (\min(1, \min(a+d-c,a+b+e-c)) = \min(a+d-c,a+b+e-c))

    specify(int.M4): \Ab: (0 >= b) -> (\max(0, b) = 0)
    specify: (0 >= \min(a+d-c,a+b+e-c)) -> (\max(0, \min(a+d-c,a+b+e-c)) = 0)
    theorem COND51d: (0 >= \min(a+d-c,a+b+e-c)) -> (\max(0, \min(a+d-c,a+b+e-c)) = 0)

    conjoin(COND51a: int.Q9a): (\min(a+d-c,a+b+e-c) <= 0) & (0 <= 1)
    ponens(COND51b): \min(a+d-c,a+b+e-c) <= 1
    add: -1 <= -\min(a+d-c,a+b+e-c)
    multiply: 1 >= \min(a+d-c,a+b+e-c)
    ponens(COND51c): \min(1, \min(a+d-c,a+b+e-c)) = \min(a+d-c,a+b+e-c)
    theorem COND51e: \min(1, \min(a+d-c,a+b+e-c)) = \min(a+d-c,a+b+e-c)

    add(COND51a): 0 <= -\min(a+d-c,a+b+e-c)
    multiply(*value -1): 0 >= \min(a+d-c,a+b+e-c)
    ponens(COND51d): \max(0, \min(a+d-c,a+b+e-c)) = 0
    equate(COND51e): \max(0, \min(1, \min(a+d-c,a+b+e-c))) = 0
    theorem COND51f: \max(0, \min(1, \min(a+d-c,a+b+e-c))) = 0

    rename(int.I1): \Ax: \Ay: \int_{f=x}^{x}{y} = 0
    specify: \Ay: \int_{f=0}^{0}{y} = 0
    theorem COND51g: \Ay: \int_{f=0}^{0}{y} = 0
    specify: \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = 0
    theorem COND51h: \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = 0
    specify(COND51g): \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) } = 0
    theorem COND51i: \int_{f=0}^{0}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) } = 0

