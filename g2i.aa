  theorem C5a: \Aa: \Ab: \Ac: \Ad: \Ae: (\min(a+d-c,a+b+e-c) <= 0) -> (\int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-c-f))^2/2 - (a+b+e-c-f)\max(0,\min(1,a+b+e-c-f)) + (a+b+e) })

  condstart: \min(a+d-c,a+b+e-c) >= 0
    theorem COND52a: \min(a+d-c,a+b+e-c) >= 0
    rename(int.M10): \Ax: \Ay: \Az: ((x >= z) & (y >= z)) -> (\min(x, y) >= z)
    specify: \Ay: \Az: ((1 >= z) & (y >= z)) -> (\min(1, y) >= z)
    specify: \Az: ((1 >= z) & (\min(a+d-c,a+b+e-c) >= z)) -> (\min(1, \min(a+d-c,a+b+e-c)) >= z)
    specify: ((1 >= 0) & (\min(a+d-c,a+b+e-c) >= 0)) -> (\min(1, \min(a+d-c,a+b+e-c)) >= 0)
    theorem COND52b: ((1 >= 0) & (\min(a+d-c,a+b+e-c) >= 0)) -> (\min(1, \min(a+d-c,a+b+e-c)) >= 0)

    rename(int.M3): \Ax: \Ay: (x <= y) -> (\max(x, y) = y)
    specify: \Ay: (0 <= y) -> (\max(0, y) = y)
    specify: (0 <= \min(1, \min(a+d-c,a+b+e-c))) -> (\max(0, \min(1, \min(a+d-c,a+b+e-c))) = \min(1, \min(a+d-c,a+b+e-c)))
    theorem COND52c: (0 <= \min(1, \min(a+d-c,a+b+e-c))) -> (\max(0, \min(1, \min(a+d-c,a+b+e-c))) = \min(1, \min(a+d-c,a+b+e-c)))

    add(int.Q9a): -1 <= 0
    multiply: 1 >= 0
    conjoin(COND52a): (1 >= 0) & (\min(a+d-c,a+b+e-c) >= 0)
    ponens(COND52b): \min(1, \min(a+d-c,a+b+e-c)) >= 0
    add: 0 >= -\min(1, \min(a+d-c,a+b+e-c))
    multiply: 0 <= \min(1, \min(a+d-c,a+b+e-c))
    ponens(COND52c): \max(0, \min(1, \min(a+d-c,a+b+e-c))) = \min(1, \min(a+d-c,a+b+e-c))
    theorem COND52d: \max(0, \min(1, \min(a+d-c,a+b+e-c))) = \min(1, \min(a+d-c,a+b+e-c))

    condstart: f <= \min(1, \min(a+d-c,a+b+e-c))
      theorem COND521a: f <= \min(1, \min(a+d-c,a+b+e-c))
      condstart: f <= \min(a+d-c,a+b+e-c)
        theorem COND522a: f <= \min(a+d-c,a+b+e-c)
        rename(int.Q10): \Ax: \Ay: \Az: ((x <= y) & (y <= z)) -> (x <= z)
        specify: \Ay: \Az: ((f <= y) & (y <= z)) -> (f <= z)
        specify: \Az: ((f <= \min(a+d-c,a+b+e-c)) & (\min(a+d-c,a+b+e-c) <= z)) -> (f <= z)
        specify: ((f <= \min(a+d-c,a+b+e-c)) & (\min(a+d-c,a+b+e-c) <= a+d-c)) -> (f <= a+d-c)
        theorem COND522b: ((f <= \min(a+d-c,a+b+e-c)) & (\min(a+d-c,a+b+e-c) <= a+d-c)) -> (f <= a+d-c)
        rename(int.M2): \Ax: \Ay: (x >= y) -> (\min(x, y) = y)
        specify: \Ay: (a+d >= y) -> (\min(a+d, y) = y)
        specify: (a+d >= c+f) -> (\min(a+d, c+f) = c+f)
        theorem COND522d: (a+d >= c+f) -> (\min(a+d, c+f) = c+f)
        rename(int.M5): \Ax: \Ay: \min(x, y) <= x
        specify: \Ay: \min(a+d-c, y) <= a+d-c
        specify: \min(a+d-c, a+b+e-c) <= a+d-c
        conjoin(COND522a): (f <= \min(a+d-c,a+b+e-c)) & (\min(a+d-c, a+b+e-c) <= a+d-c)
        ponens(COND522b): f <= a+d-c
        add: -a-d <= -c-f
        multiply(*value -1): a+d >= c+f
      condend: (f <= \min(a+d-c,a+b+e-c)) -> (a+d >= c+f)
      theorem COND521b: (f <= \min(a+d-c,a+b+e-c)) -> (a+d >= c+f)

      rename(int.M6): \Ax: \Ay: \min(x, y) <= y
      specify: \Ay: \min(1, y) <= y
      specify: \min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c)
      theorem COND521c: \min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c)

      rename(int.Q10): \Ax: \Ay: \Az: (((x <= y) & (y <= z)) -> (x <= z))
      specify: \Ay: \Az: (((f <= y) & (y <= z)) -> (f <= z))
      specify: \Az: (((f <= \min(1, \min(a+d-c,a+b+e-c))) & (\min(1, \min(a+d-c,a+b+e-c)) <= z)) -> (f <= z))
      specify: (((f <= \min(1, \min(a+d-c,a+b+e-c))) & (\min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c))) -> (f <= \min(a+d-c,a+b+e-c)))
      theorem COND521d: (((f <= \min(1, \min(a+d-c,a+b+e-c))) & (\min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c))) -> (f <= \min(a+d-c,a+b+e-c)))

      conjoin(COND521a: COND521c): (f <= \min(1, \min(a+d-c,a+b+e-c))) & (\min(1, \min(a+d-c,a+b+e-c)) <= \min(a+d-c,a+b+e-c))
      ponens(COND521d): f <= \min(a+d-c,a+b+e-c)
      ponens(COND521b): a+d >= c+f
    condend: \Af: (f <= \min(1, \min(a+d-c,a+b+e-c))) -> (a+d >= c+f)
    equate(COND52d): \Af: (f <= \max(0, \min(1, \min(a+d-c,a+b+e-c)))) -> (a+d >= c+f)
    theorem COND52e: \Af: (f <= \max(0, \min(1, \min(a+d-c,a+b+e-c)))) -> (a+d >= c+f)

    identity: \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) } = \int_{f=0}^{\max(0,\min(1,\min(a+d-c,a+b+e-c)))}{ \max(0,\min(1,a+b+e-\min(a+d,c+f)))^2/2 + \min(a+d,c+f)\max(0,\min(1,a+b+e-\min(a+d,c+f))) + (a+b+e) - (a+b+e)\max(0,\min(1,a+b+e-\min(a+d,c+f))) }
