specify(int.M9): \Ab: (0 <= b) -> (\Ac: \max(0,\min(b,c)) = \min(b,\max(0,c)))
specify: (0 <= 1) -> (\Ac: \max(0,\min(1,c)) = \min(1,\max(0,c)))
