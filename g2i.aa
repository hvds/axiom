rename(int.I3): \Ah: \Ai: \int_{g=0}^{\max(0,\min(1,h-i))}{ \min(h,i+g) } = \int_{g=0}^{\max(0,\min(1,h-i))}{ i+g }
specify: \Aa: \Ab: \Ae: \Ai: \int_{g=0}^{\max(0,\min(1,a+b+e-i))}{ \min(a+b+e,i+g) } = \int_{g=0}^{\max(0,\min(1,a+b+e-i))}{ i+g }
specify: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+b+e,\min(a+d,c+f)+g) } = \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+d,c+f)+g }
theorem C2: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+b+e,\min(a+d,c+f)+g) } = \int_{g=0}^{\max(0,\min(1,a+b+e-\min(a+d,c+f)))}{ \min(a+d,c+f)+g }

rename(int.I4): \Ah: \Ai: \int_{g=\max(0,\min(1,h-i))}^{1}{ \min(h,i+g) } = \int_{g=\max(0,\min(1,h-i))}^{1}{ h }
specify: \Aa: \Ab: \Ae: \Ai: \int_{g=\max(0,\min(1,a+b+e-i))}^{1}{ \min(a+b+e,i+g) } = \int_{g=\max(0,\min(1,a+b+e-i))}^{1}{ a+b+e }
specify: \Aa: \Ab: \Ac: \Ad: \Ae: \Af: \int_{g=\max(0,\min(1,a+b+e-\min(a+d,c+f)))}^{1}{ \min(a+b+e,\min(a+d,c+f)+g) } = \int_{g=\max(0,\min(1,a+b+e-\min(a+d,c+f)))}^{1}{ a+b+e }
