*import int
*func E

condstart: (x >= 0) & (x <= 1)
theorem COND1a: (x >= 0) & (x <= 1)
simplify: x >= 0
multiply: -x <= 0
add: 1-x <= 1
theorem COND1b: 1-x <= 1
simplify(COND1a): x <= 1
multiply: -x >= -1
add: 1-x >= 0
conjoin(COND1b): (1-x >= 0) & (1-x <= 1)
condend: \Aa: ((a >= 0) & (a <= 1)) -> ((1-a >= 0) & (1-a <= 1))
theorem C1: \Aa: ((a >= 0) & (a <= 1)) -> ((1-a >= 0) & (1-a <= 1))

condstart: (x >= 0) & (y >= 0) & (y <= 1-x)
theorem COND2a: (x >= 0) & (y >= 0) & (y <= 1-x)
specify(int.Q7): \Ab: \Ac: \Ad: ((x >= c) & (b >= d)) -> (x+b >= c+d)
specify: \Ac: \Ad: ((x >= c) & (y >= d)) -> (x+y >= c+d)
specify: \Ad: ((x >= 0) & (y >= d)) -> (x+y >= d)
specify: ((x >= 0) & (y >= 0)) -> (x+y >= 0)
theorem COND2c: ((x >= 0) & (y >= 0)) -> (x+y >= 0)
simplify(COND2a): (x >= 0) & (y >= 0)
ponens(COND2c): x+y >= 0
theorem COND2b: x+y >= 0
simplify(COND2a): y <= 1-x
add: x+y <= 1
conjoin(COND2b): (x+y >= 0) & (x+y <= 1)
condend: \Aa: \Ab: ((a >= 0) & (b >= 0) & (b <= 1-a)) -> ((a+b >= 0) & (a+b <= 1))
theorem C2: \Aa: \Ab: ((a >= 0) & (b >= 0) & (b <= 1-a)) -> ((a+b >= 0) & (a+b <= 1))

condstart: (x <= 1) & (y >= 1-x) & (y <= 1)
theorem COND3a: (x <= 1) & (y >= 1-x) & (y <= 1)
specify(int.Q8): \Ab: \Ac: \Ad: ((x <= c) & (b <= d)) -> (x+b <= c+d)
specify: \Ac: \Ad: ((x <= c) & (y <= d)) -> (x+y <= c+d)
specify: \Ad: ((x <= 1) & (y <= d)) -> (x+y <= 1+d)
specify: ((x <= 1) & (y <= 1)) -> (x+y <= 2)
theorem COND3c: ((x <= 1) & (y <= 1)) -> (x+y <= 2)
simplify(COND3a): y >= 1-x
add: x+y-1 >= 0
theorem COND3b: x+y-1 >= 0
simplify(COND3a): (x <= 1) & (y <= 1)
ponens(COND3c): x+y <= 2
add: x+y-1 <= 1
conjoin(COND3b): (x+y-1 >= 0) & (x+y-1 <= 1)
condend: \Aa: \Ab: ((a <= 1) & (b >= 1-a) & (b <= 1)) -> ((a+b-1 >= 0) & (a+b-1 <= 1))
theorem C3: \Aa: \Ab: ((a <= 1) & (b >= 1-a) & (b <= 1)) -> ((a+b-1 >= 0) & (a+b-1 <= 1))

condstart: (y <= 1-x) & (z >= 0) & (z <= x+y)
theorem COND4a: (y <= 1-x) & (z >= 0) & (z <= x+y)
specify(int.Q8): \Ab: \Ac: \Ad: ((x+y <= c) & (b <= d)) -> (x+y+b <= c+d) 
specify: \Ac: \Ad: ((x+y <= c) & (-z <= d)) -> (x+y-z <= c+d) 
specify: \Ad: ((x+y <= 1) & (-z <= d)) -> (x+y-z <= 1+d) 
specify: ((x+y <= 1) & (-z <= 0)) -> (x+y-z <= 1) 
theorem COND4d: ((x+y <= 1) & (-z <= 0)) -> (x+y-z <= 1)
simplify(COND4a): z <= x+y
multiply: -z >= -x-y
add: x+y-z >= 0
theorem COND4b: x+y-z >= 0
simplify(COND4a): y <= 1-x
add: x+y <= 1
theorem COND4c: x+y <= 1
simplify(COND4a): z >= 0
multiply: -z <= 0
conjoin(COND4c): (x+y <= 1) & (-z <= 0)
ponens(COND4d): x+y-z <= 1
conjoin(COND4b): (x+y-z >= 0) & (x+y-z <= 1)
condend: \Aa: \Ab: \Ac: ((b <= 1-a) & (c >= 0) & (c <= a+b)) -> ((a+b-c >= 0) & (a+b-c <= 1))
theorem C4: \Aa: \Ab: \Ac: ((b <= 1-a) & (c >= 0) & (c <= a+b)) -> ((a+b-c >= 0) & (a+b-c <= 1))

condstart: w <= x+y-z
multiply: -w >= -x-y+z
add: x+y >= z+w
condend: \Aa: \Ab: \Ac: \Ad: (d <= a+b-c) -> (a+b >= c+d)
theorem C5: \Aa: \Ab: \Ac: \Ad: (d <= a+b-c) -> (a+b >= c+d)

condstart: w >= x+y-z
multiply: -w <= -x-y+z
add: x+y <= z+w
condend: \Aa: \Ab: \Ac: \Ad: (d >= a+b-c) -> (a+b <= c+d)
theorem C6: \Aa: \Ab: \Ac: \Ad: (d >= a+b-c) -> (a+b <= c+d)

condstart: (z >= x+y) & (w >= 0)
theorem COND7a: (z >= x+y) & (w >= 0)
specify(int.Q7): \Ab: \Ac: \Ad: ((z >= c) & (b >= d)) -> (z+b >= c+d)
specify: \Ac: \Ad: ((z >= c) & (w >= d)) -> (z+w >= c+d)
specify: \Ad: ((z >= x+y) & (w >= d)) -> (z+w >= x+y+d)
specify: ((z >= x+y) & (w >= 0)) -> (z+w >= x+y)
theorem COND7b: ((z >= x+y) & (w >= 0)) -> (z+w >= x+y)
ponens(COND7a: COND7b): z+w >= x+y
multiply(*value -1): -z-w <= -x-y
add: x+y <= z+w
condend: \Aa: \Ab: \Ac: \Ad: ((c >= a+b) & (d >= 0)) -> (a+b <= c+d)
theorem C7: \Aa: \Ab: \Ac: \Ad: ((c >= a+b) & (d >= 0)) -> (a+b <= c+d)

condstart: (z <= x+y-1) & (w <= 1)
theorem COND8a: (z <= x+y-1) & (w <= 1)
specify(int.Q8): \Ab: \Ac: \Ad: ((z <= c) & (b <= d)) -> (z+b <= c+d)
specify: \Ac: \Ad: ((z <= c) & (w <= d)) -> (z+w <= c+d)
specify: \Ad: ((z <= x+y-1) & (w <= d)) -> (z+w <= x+y-1+d)
specify: ((z <= x+y-1) & (w <= 1)) -> (z+w <= x+y)
theorem COND8b: ((z <= x+y-1) & (w <= 1)) -> (z+w <= x+y)
ponens(COND8a: COND8b): z+w <= x+y
multiply(*value -1): -z-w >= -x-y
add: x+y >= z+w
condend: \Aa: \Ab: \Ac: \Ad: ((c <= a+b-1) & (d <= 1)) -> (a+b >= c+d)
theorem C8: \Aa: \Ab: \Ac: \Ad: ((c <= a+b-1) & (d <= 1)) -> (a+b >= c+d)

condstart: (x >= 0) & (x <= 1) & (y >= 1-x) & (y <= 1) & (z >= x+y-1) & (z <= 1)
theorem COND9a: (x >= 0) & (x <= 1) & (y >= 1-x) & (y <= 1) & (z >= x+y-1) & (z <= 1)
specify(int.Q7): \Ab: \Ac: \Ad: ((y >= c) & (b >= d)) -> (y+b >= c+d)
specify: \Ac: \Ad: ((y >= c) & (-z >= d)) -> (y-z >= c+d)
specify: \Ad: ((y >= 1-x) & (-z >= d)) -> (y-z >= 1-x+d)
specify: ((y >= 1-x) & (-z >= -1)) -> (y-z >= -x)
theorem COND9d: ((y >= 1-x) & (-z >= -1)) -> (y-z >= -x)
simplify(COND9a): z <= 1
multiply: -z >= -1
theorem COND9b: -z >= -1
simplify(COND9a): y >= 1-x
conjoin(COND9b): (y >= 1-x) & (-z >= -1)
ponens(COND9d): y-z >= -x
add: x+y-z >= 0
theorem COND9c: x+y-z >= 0
simplify(COND9a): z >= x+y-1
multiply: -z <= -x-y+1
add: x+y-z <= 1
conjoin(COND9c): (x+y-z >= 0) & (x+y-z <= 1)
condend: \Aa: \Ab: \Ac: ((a >= 0) & (a <= 1) & (b >= 1-a) & (b <= 1) & (c >= a+b-1) & (c <= 1)) -> ((a+b-c >= 0) & (a+b-c <= 1))
theorem C9: \Aa: \Ab: \Ac: ((a >= 0) & (a <= 1) & (b >= 1-a) & (b <= 1) & (c >= a+b-1) & (c <= 1)) -> ((a+b-c >= 0) & (a+b-c <= 1))

axiom A1: E(2, 3) = \int_{a=0}^1{\int_{b=0}^1{\int_{c=0}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
itersplit(*with C1): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^1{\int_{d=0}^1{\min(a + b, c + d)}}}+\int_{b=1-a}^1{\int_{c=0}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
itersplit(*with C2): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^1{\min(a + b, c + d)}}+\int_{c=a+b}^1{\int_{d=0}^1{\min(a + b, c + d)}}}+\int_{b=1-a}^1{\int_{c=0}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
itersplit(*with C3): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^1{\min(a + b, c + d)}}+\int_{c=a+b}^1{\int_{d=0}^1{\min(a + b, c + d)}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{\min(a + b, c + d)}}+\int_{c=a+b-1}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
itersplit(*with C4): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{\min(a + b, c + d)}+\int_{d=a+b-c}^1{\min(a + b, c + d)}}+\int_{c=a+b}^1{\int_{d=0}^1{\min(a + b, c + d)}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{\min(a + b, c + d)}}+\int_{c=a+b-1}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
minmax(*with C5): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{\min(a + b, c + d)}}+\int_{c=a+b}^1{\int_{d=0}^1{\min(a + b, c + d)}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{\min(a + b, c + d)}}+\int_{c=a+b-1}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
minmax(*with C6): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{\min(a + b, c + d)}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{\min(a + b, c + d)}}+\int_{c=a+b-1}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
minmax(*with C7): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{\min(a + b, c + d)}}+\int_{c=a+b-1}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
minmax(*with C8): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^1{\min(a + b, c + d)}}}}
itersplit(*with C9): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{\min(a + b, c + d)}+\int_{d=a+b-c}^1{\min(a + b, c + d)}}}}
minmax(*with C5): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{\min(a + b, c + d)}}}}
minmax(*with C6): E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
integrate: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{\inteval_{d=0}^{a+b-c}{cd + d^2/2}+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
inteval: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{ac + bc - c^2 + (a + b - c)^2/2+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
unarydistrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{(a^2 + b^2 - c^2 + 2ab)/2+\int_{d=a+b-c}^1{a + b}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
integrate: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{(a^2 + b^2 - c^2 + 2ab)/2+\inteval_{d=a+b-c}^1{ad + bd}}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
inteval: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{(a^2 + b^2 - c^2 + 2ab)/2 + a + b - a(a + b - c) - b(a + b - c)}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
distrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{(a^2 + b^2 - c^2 + 2ab)/2 + a + b - a^2 - 2ab - b^2 + ac + bc}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
distrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\int_{c=0}^{a+b}{(2a + 2b - a^2 - b^2 - 2ab + 2ac + 2bc - c^2)/2}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
integrate: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{\inteval_{c=0}^{a+b}{(2ac + 2bc - a^{2}c - b^{2}c - 2abc + ac^2 + bc^2 - c^3/3)/2}+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
inteval: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{(2a(a + b) + 2b(a + b) - a^{2}(a + b) - b^{2}(a + b) - 2ab(a + b) + a(a + b)^2 + b(a + b)^2 - (a + b)^3/3)/2+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
distrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{(2a^2 + 4ab + 2b^2 - a^{2}(a + b) - b^{2}(a + b) - 2ab(a + b) + a(a + b)^2 + b(a + b)^2 - (a + b)^3/3)/2+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
unarydistrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{(2a^2 + 4ab + 2b^2 - a^{2}(a + b) - b^{2}(a + b) - 2ab(a + b) + a(a^2 + 2ab + b^2) + b(a + b)^2 - (a + b)^3/3)/2+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
unarydistrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{(2a^2 + 4ab + 2b^2 - a^{2}(a + b) - b^{2}(a + b) - 2ab(a + b) + a(a^2 + 2ab + b^2) + b(a^2 + 2ab + b^2) - (a + b)^3/3)/2+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
unarydistrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{(2a^2 + 4ab + 2b^2 - a^{2}(a + b) - b^{2}(a + b) - 2ab(a + b) + a(a^2 + 2ab + b^2) + b(a^2 + 2ab + b^2) - (a^3 + 3a^{2}b + 3ab^2 + b^3)/3)/2+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
distrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{(6a^2 + 12ab + 6b^2 - 3a^{2}(a + b) - 3b^{2}(a + b) - 6ab(a + b) + 3a(a^2 + 2ab + b^2) + 3b(a^2 + 2ab + b^2) - (a^3 + 3a^{2}b + 3ab^2 + b^3))/6+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
distrib: E(2, 3) = \int_{a=0}^1{\int_{b=0}^{1-a}{(6a^2 + 12ab + 6b^2 - a^3 - 3a^{2}b - 3ab^2 - b^3)/6+\int_{c=a+b}^1{\int_{d=0}^1{a + b}}}+\int_{b=1-a}^1{\int_{c=0}^{a+b-1}{\int_{d=0}^1{c + d}}+\int_{c=a+b-1}^1{\int_{d=0}^{a+b-c}{c + d}+\int_{d=a+b-c}^1{a + b}}}}
