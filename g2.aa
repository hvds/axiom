*var A
axiom A1: A = \int_{a=0}^1{ \int_{b=0}^1{ \int_{c=0}^1{ \int_{d=0}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,\min(a+d,c+f)+g) } } } } } } }

#
# Phase 1: resolve \min(a+d,c+f) by splitting integrals until we can show
# either f <= a+d-c or f >= a+d-c.
#
*import g2p1
ponens(A1: g2p1.CP1) P1: A = \int_{a=0}^1{ \int_{b=0}^1{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^1{ \int_{d=0}^{c-a}{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } + \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } + \int_{f=a+d-c}^1{ \int_{g=0}^1{ a+\min(b+e,d+g) } } } } } } }

#
# Phase 2: resolve \min(b+e,d+g) by splitting integrals until we can show
# either g <= b+e-d or g >= b+e-d; evaluate the resulting integrals over g.
#
*import g2p2
ponens(P1: g2p2.CP2) P2: A = \int_{a=0}^1{ \int_{b=0}^{1-a}{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } + \int_{d=0}^b{ \int_{e=0}^{1-b+d}{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=a+d-c}^1{ (2a+2d+1)/2 } } } + \int_{d=b}^{1-a+c}{ \int_{e=0}^{d-b}{ \int_{f=a+d-c}^1{ a+b+e } } + \int_{e=d-b}^1{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } } + \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^{a+b}{ \int_{d=0}^{c-a}{ \int_{e=0}^{1-b+d}{ \int_{f=0}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=0}^1{ (2a+2d+1)/2 } } } } + \int_{c=a+b}^1{ \int_{d=0}^b{ \int_{e=0}^{1-b+d}{ \int_{f=0}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=0}^1{ (2a+2d+1)/2 } } } + \int_{d=b}^{c-a}{ \int_{e=0}^{d-b}{ \int_{f=0}^1{ a+b+e } } + \int_{e=d-b}^1{ \int_{f=0}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } } } + \int_{c=a}^1{ \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^{a+b}{ \int_{d=c-a}^b{ \int_{e=0}^{1-b+d}{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=a+d-c}^1{ (2a+2d+1)/2 } } } + \int_{d=b}^1{ \int_{e=0}^{d-b}{ \int_{f=a+d-c}^1{ a+b+e } } + \int_{e=d-b}^1{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } } } + \int_{c=a+b}^1{ \int_{d=c-a}^1{ \int_{e=0}^{d-b}{ \int_{f=a+d-c}^1{ a+b+e } } + \int_{e=d-b}^1{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } } } } + \int_{b=1-a}^1{ \int_{c=0}^a{ \int_{d=0}^{1-a+c}{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=0}^{a+b-1}{ \int_{d=0}^{1-a+c}{ \int_{e=0}^{1-b+d}{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=a+d-c}^1{ (2a+2d+1)/2 } } } } + \int_{c=a+b-1}^a{ \int_{d=0}^b{ \int_{e=0}^{1-b+d}{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=a+d-c}^1{ (2a+2d+1)/2 } } } + \int_{d=b}^{1-a+c}{ \int_{e=0}^{d-b}{ \int_{f=a+d-c}^1{ a+b+e } } + \int_{e=d-b}^1{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } } } + \int_{c=0}^a{ \int_{d=1-a+c}^1{ \int_{e=0}^1{ \int_{f=0}^1{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } } + \int_{c=a}^1{ \int_{d=0}^{c-a}{ \int_{e=0}^{1-b+d}{ \int_{f=0}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=0}^1{ (2a+2d+1)/2 } } } + \int_{d=c-a}^1{ \int_{e=0}^1{ \int_{f=0}^{a+d-c}{ \int_{g=0}^1{ \min(a+b+e,c+f+g) } } } } + \int_{d=c-a}^b{ \int_{e=0}^{1-b+d}{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } + \int_{e=1-b+d}^1{ \int_{f=a+d-c}^1{ (2a+2d+1)/2 } } } + \int_{d=b}^1{ \int_{e=0}^{d-b}{ \int_{f=a+d-c}^1{ a+b+e } } + \int_{e=d-b}^1{ \int_{f=a+d-c}^1{ (2(a+b+e) - (b+e-d)^2)/2 } } } } } }

#
# Phase 3: resolve \min(a+b+e,c+f+g) by splitting integrals until we can show
# either g <= a+b+e-c-f or g >= a+b+e-c-f; evaluate the integrals over g.
#
