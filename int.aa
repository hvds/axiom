# inequalities
axiom Q1: \Aa: \Ab: (a < b) -> (a <= b)
axiom Q2: \Aa: \Ab: (a > b) -> (a >= b)
axiom Q3: \Aa: \Ab: (a = b) -> (a <= b)
axiom Q4: \Aa: \Ab: (a = b) -> (a >= b)
axiom Q5: \Aa: \Ab: (a < b) | (a = b) | (a > b)
axiom Q6: \Aa: \Ab: (a >= b) | (a <= b)
axiom Q7: \Aa: \Ab: \Ac: \Ad: ((a >= c) & (b >= d)) -> (a+b >= c+d)
axiom Q8: \Aa: \Ab: \Ac: \Ad: ((a <= c) & (b <= d)) -> (a+b <= c+d)
# with add/multiply/identity we can derive all other const relations
axiom Q9: 0 < 1
  specify(Q1) Q9i1: (0 < 1) -> (0 <= 1)
  ponens(Q9: Q9i1): 0 <= 1
theorem Q9a: 0 <= 1
axiom Q10: \Aa: \Ab: \Ac: ((a <= b) & (b <= c)) -> (a <= c)
axiom Q11: \Aa: \Ab: \Ac: ((a >= b) & (b >= c)) -> (a >= c)
#axiom Q12: \Aa: \Ab: (a <= b) = (b >= a)
#axiom Q13: \Aa: \Ab: (a < b) = (b > a)

# minimum and maximum
axiom M1: \Aa: \Ab: (a <= b) -> (\min(a, b) = a)
axiom M2: \Aa: \Ab: (a >= b) -> (\min(a, b) = b)
axiom M3: \Aa: \Ab: (a <= b) -> (\max(a, b) = b)
axiom M4: \Aa: \Ab: (a >= b) -> (\max(a, b) = a)
axiom M5: \Aa: \Ab: \min(a, b) <= a
axiom M6: \Aa: \Ab: \min(a, b) <= b
axiom M7: \Aa: \Ab: \max(a, b) >= a
axiom M8: \Aa: \Ab: \max(a, b) >= b
axiom M9: \Aa: \Ab: (a <= b) -> (\Ac: \max(a,\min(b,c)) = \min(b,\max(a,c)))
condstart M10a: (a >= c) & (b >= c)
  condstart: a <= b
    ponens(M1) M10ba: \min(a, b) = a
    simplify(M10a): a >= c
    equate(M10ba): \min(a, b) >= c
  condend M10b: (a <= b) -> (\min(a, b) >= c)
  condstart: a >= b
    ponens(M2) M10ca: \min(a, b) = b
    simplify(M10a): b >= c
    equate(M10ca): \min(a, b) >= c
  condend: (a >= b) -> (\min(a, b) >= c)
  cases(M10b) M10c: ((a >= b) | (a <= b)) -> (\min(a, b) >= c)
  specify(Q6): (a >= b) | (a <= b)
  ponens(M10c): \min(a, b) >= c
condend: \Aa: \Ab: \Ac: ((a >= c) & (b >= c)) -> (\min(a, b) >= c)
theorem M10: \Aa: \Ab: \Ac: ((a >= c) & (b >= c)) -> (\min(a, b) >= c)
condstart M11a: (a <= c) & (b <= c)
  condstart: a <= b
    ponens(M3) M11ba: \max(a, b) = b
    simplify(M11a): b <= c
    equate(M11ba): \max(a, b) <= c
  condend M11b: (a <= b) -> (\max(a, b) <= c)
  condstart: a >= b
    ponens(M4) M11ca: \max(a, b) = a
    simplify(M11a): a <= c
    equate(M11ca): \max(a, b) <= c
  condend: (a >= b) -> (\max(a, b) <= c)
  cases(M11b) M11c: ((a >= b) | (a <= b)) -> (\max(a, b) <= c)
  specify(Q6): (a >= b) | (a <= b)
  ponens(M11c): \max(a, b) <= c
condend: \Aa: \Ab: \Ac: ((a <= c) & (b <= c)) -> (\max(a, b) <= c)
theorem M11: \Aa: \Ab: \Ac: ((a <= c) & (b <= c)) -> (\max(a, b) <= c)
  condstart M12C1a: x <= 0
    conjoin(Q9a): (x <= 0) & (0 <= 1)
    ponens(Q10): x <= 1
    multiply: -x >= -1
    add: 1 >= x
    ponens(M2) M12C1b: \min(1, x) = x
    equate(M12C1a: M12C1b): \min(1, x) <= 0
    multiply: -\min(1, x) >= 0
    add: 0 >= \min(1, x)
    ponens(M4) M12C1c: \max(0, \min(1, x)) = 0
    multiply(M12C1a:): -x >= 0
    add: 0 >= x
    ponens(M4) M12C1d: \max(0, x) = 0
    add(Q9a): -1 <= 0
    multiply: 1 >= 0
    ponens(M2): \min(1, 0) = 0
    equate(M12C1d): \min(1, \max(0, x)) = 0
    equate(M12C1c): \max(0, \min(1, x)) = \min(1, \max(0, x))
  condend M12C1: \Ax: (x <= 0) -> (\max(0, \min(1, x)) = \min(1, \max(0, x)))
  condstart M12C2a: x >= 0
    multiply: -x <= 0
    add: 0 <= x
    ponens(M3) M12C2b: \max(0, x) = x
    condstart: x <= 1
      multiply: -x >= -1
      add: 1 >= x
      ponens(M2) M12C3a: \min(1, x) = x
      equate(M12C2b: M12C3a) M12C3b: \max(0, \min(1, x)) = x
      equate(M12C3a: M12C2b): \min(1, \max(0, x)) = x
      equate(M12C3b): \max(0, \min(1, x)) = \min(1, \max(0, x))
    condend M12C3: (x <= 1) -> (\max(0, \min(1, x)) = \min(1, \max(0, x)))
    condstart: x >= 1
      multiply: -x <= -1
      add: 1 <= x
      ponens(M1) M12C4a: \min(1, x) = 1
      ponens(Q9a: M3): \max(0, 1) = 1
      equate(M12C4a) M12C4b: \max(0, \min(1, x)) = 1
      equate(M12C4a: M12C2b):  \min(1, \max(0, x)) = 1
      equate(M12C4b): \max(0, \min(1, x)) = \min(1, \max(0, x))
    condend: (x >= 1) -> (\max(0, \min(1, x)) = \min(1, \max(0, x)))
    cases(M12C3) M12C2c: ((x >= 1) | (x <= 1)) -> (\max(0, \min(1, x)) = \min(1, \max(0, x)))
    specify(Q6): (x >= 1) | (x <= 1)
    ponens(M12C2c): \max(0, \min(1, x)) = \min(1, \max(0, x))
  condend: \Ax: (x >= 0) -> (\max(0, \min(1, x)) = \min(1, \max(0, x)))
  cases(M12C1): \Ax: ((x >= 0) | (x <= 0)) -> (\max(0, \min(1, x)) = \min(1, \max(0, x)))
  unarydistrib M12C2: (\Ax: (x >= 0) | (x <= 0)) -> (\Ax: \max(0, \min(1, x)) = \min(1, \max(0, x)))
  specify(Q6): \Ax: (x >= 0) | (x <= 0)
  ponens(M12C2): \Ax: \max(0, \min(1, x)) = \min(1, \max(0, x))
theorem M12: \Ax: \max(0, \min(1, x)) = \min(1, \max(0, x))

  condstart M13a: a+b <= a+c
    ponens(M1) M13b: \min(a+b,a+c) = a+b
    add(M13a): b <= c
    ponens(M1): \min(b,c) = b
    add: a+\min(b,c) = a+b
    equate(M13b): \min(a+b,a+c) = a+\min(b,c)
  condend M13c: \Aa: \Ab: \Ac: (a+b <= a+c) -> (\min(a+b,a+c) = a+\min(b,c))
  condstart M13d: a+b >= a+c
    ponens(M2) M13e: \min(a+b,a+c) = a+c
    add(M13d): b >= c
    ponens(M2): \min(b,c) = c
    add: a+\min(b,c) = a+c
    equate(M13e): \min(a+b,a+c) = a+\min(b,c)
  condend: \Aa: \Ab: \Ac: (a+b >= a+c) -> (\min(a+b,a+c) = a+\min(b,c))
  cases(M13c) M13f: \Aa: \Ab: \Ac: ((a+b >= a+c) | (a+b <= a+c)) -> (\min(a+b,a+c) = a+\min(b,c))
  specify(Q6): \Aa: \Ab: \Ac: (a+b >= a+c) | (a+b <= a+c)
  ponens(M13f): \Aa: \Ab: \Ac: \min(a+b,a+c) = a+\min(b,c)
theorem M13: \Aa: \Ab: \Ac: \min(a+b,a+c) = a+\min(b,c)

# integrals
axiom I1: \Aa: \Ab: \int_{c=a}^{a}{b} = 0

# Concatenation of ranges: [\min(a, b), \max(a, b)]
#  = [\min(a, b), \min(a, b)+\max(0,a-b)] U [\min(a, b), \min(a, b)+\max(0,b-a)]
# .. since (at least) one of these is identical to the original range, with
# the other one being an empty range.
#
axiom I2: \Aa: \Ab: \Ac: \Ad: \int_{e=\min(a, b)}^{c}{d} = \int_{e=\min(a, b)}^{\min(a, b)+\max(0,a-b)}{d} + \int_{e=\min(a, b)}^{\min(a, b)+\max(0,b-a)}{d} + \int_{e=\max(a, b)}^{c}{d}
